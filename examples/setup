#!/bin/sh
# First-time bootstrap. Run once after cloning:  ./setup
set -e
cd "$(dirname "$0")"

if ! command -v splash >/dev/null 2>&1; then
    echo "splash is not on your PATH. Install it first:" >&2
    echo "    brew install nielsmadan/tap/splashdown" >&2
    echo "    # or: pipx install splashdown" >&2
    exit 1
fi

splash init
splash
echo
echo "Done. Future 'git checkout' / 'git worktree add' provision automatically."
