{
  "branch": "main",
  "components": 3,
  "initial_version": "0.1.0",
  "checks": [
    [
      "just",
      "check"
    ]
  ],
  "tools": [
    "git",
    "python3",
    "just",
    "uv",
    "uvx",
    "gh"
  ],
  "stages": [
    {
      "files": [
        "pyproject.toml",
        "uv.lock",
        "CHANGELOG.md"
      ],
      "commands": [
        [
          "python3",
          "scripts/prepare_release.py",
          "{version}"
        ],
        [
          "uv",
          "lock"
        ],
        [
          "uvx",
          "git-cliff@2.13.1",
          "--tag",
          "v{version}",
          "-o",
          "CHANGELOG.md"
        ]
      ],
      "message": "chore: release {version}"
    }
  ],
  "name": "Splashdown",
  "repository": "nielsmadan/splashdown",
  "workflow": "release.yml",
  "suggest": [
    "uvx",
    "git-cliff@2.13.1",
    "--bumped-version"
  ],
  "publication": "GitHub release and Homebrew formula update"
}
